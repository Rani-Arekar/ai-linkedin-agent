# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider (mock is safe for local development)
LLM_PROVIDER=mock
LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Persistence
DATABASE_URL=sqlite:///./linkedin_agent.db

# Scheduler and workflow thresholds
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0
QUALITY_THRESHOLD=80
SIMILARITY_THRESHOLD=0.80
AUTO_PUBLISH=false

# Research service
RESEARCH_TIMEOUT_SECONDS=15
MAX_ARTICLES_PER_SOURCE=20
# Comma-separated overrides. Leave blank to enable all configured sources.
ENABLED_RESEARCH_SOURCES=
# Comma-separated AI relevance keywords.
RESEARCH_KEYWORDS=artificial intelligence,AI,machine learning,deep learning,generative AI,large language model,LLM,computer vision,natural language processing,NLP,multimodal,AI agent,robotics,neural network,transformer,MLOps,responsible AI

# Topic selection
TOPIC_SELECTION_MIN_SCORE=4.0
TOPIC_SELECTION_MAX_CANDIDATES=20
TOPIC_SELECTION_DIVERSITY_WEIGHT=0.10
TOPIC_SELECTION_FRESHNESS_WEIGHT=0.15

# LinkedIn draft generation
LINKEDIN_POST_MAX_CHARACTERS=3000
LINKEDIN_POST_MIN_CHARACTERS=100
LINKEDIN_MAX_HASHTAGS=5

# LangGraph workflow
WORKFLOW_MAX_RETRIES=2
WORKFLOW_ENABLE_DUPLICATE_CHECK=true

# Scheduler (disabled by default)
SCHEDULER_ENABLED=false
SCHEDULE_TIME=09:00
SCHEDULE_TIMEZONE=Asia/Kolkata
MAX_CONCURRENT_WORKFLOWS=1

# LinkedIn OAuth/API (publishing is disabled by default)
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202601
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDIN_TOKEN_ENCRYPTION_KEY=
LINKEDIN_PUBLISHING_ENABLED=false
LINKEDIN_HTTP_TIMEOUT=20

# LinkedIn OAuth/API (publishing is disabled by default)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202601
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDIN_TOKEN_ENCRYPTION_KEY=
LINKEDIN_PUBLISHING_ENABLED=false
LINKEDIN_HTTP_TIMEOUT=20